test "placing and removing panels updates the totals"
  expect text "count" == "3"
  expect text "capacity" == "1.3kW"
  expect text "output" == "1.2kW"
  tap "slot-4"
  tap "slot-13"
  expect text "count" == "5"
  expect text "capacity" == "2.1kW"
  expect text "output" == "1.6kW"
  tap "slot-1"
  expect text "count" == "4"
  tap "clear"
  expect text "count" == "0"
  expect text "output" == "0W"
