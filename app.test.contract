test "wizard: welcome, configure, skip photo, layout, finish, production"
  clock +5
  expect tree has "get-started-button"
  tap "get-started-button"
  clock settle
  expect tree has "step-1"
  expect tree has "inverter-14"
  tap "continue"
  clock settle
  expect tree has "take-photo-button"
  expect disabled "take-photo-button"
  tap "skip"
  clock settle
  expect tree has "step-3"
  expect tree missing "panel-1"
  expect tree missing "finish"
  tap "add-panel"
  clock settle
  expect tree has "panel-1"
  expect text "unlinked-count" == "1"
  expect tree has "finish"
  tap "finish"
  clock settle
  expect tree has "total-output"
  expect tree has "prod-panel-1"
  expect tree has "compass-readonly"

test "wizard without photo: mock grid, all unlinked; drag with snap, rotate, zoom, link"
  clock +5
  tap "get-started-button"
  clock settle
  tap "continue"
  clock settle
  tap "continue-without-photo"
  clock settle
  expect tree has "panel-10"
  expect text "unlinked-count" == "10"
  tap "panel-1"
  expect tree has "rotate-panel"
  tap "panel-1" drag 0 300
  clock settle
  expect state layout.panels.9.id == "panel-1"
  tap "rotate-panel"
  clock settle
  expect state layout.panels.9.rotation == 90
  tap "zoom-out"
  expect enabled "zoom-in"
  tap "zoom-out"
  expect disabled "zoom-out"
  tap "panel-9"
  tap "link-panel"
  clock settle
  tap "pick-1"
  clock settle
  expect text "unlinked-count" == "9"

test "compass: the toggle opens Array Orientation, a drag sets config.compassDirection"
  clock +5
  tap "get-started-button"
  clock settle
  tap "continue"
  clock settle
  tap "skip"
  clock settle
  expect tree missing "compass"
  tap "toggle-compass"
  clock settle
  expect tree has "compass-help"
  tap "compass-help-close"
  clock settle
  expect tree has "compass"
  expect state config.compassDirection == 0
  tap "compass" drag 30 0
  clock settle
  expect state config.compassDirection == 90
  tap "compass" drag 0 30
  clock settle
  expect state config.compassDirection == 180

test "production menu: edit configuration, roof, tilt, inverter sheet, wattage"
  clock +5
  tap "get-started-button"
  clock settle
  tap "continue"
  clock settle
  tap "continue-without-photo"
  clock settle
  tap "panel-1"
  tap "link-panel"
  clock settle
  tap "pick-1"
  clock settle
  tap "finish"
  clock settle
  expect text "total-output" == "409W"
  tap "prod-panel-1"
  clock settle
  expect text "prod-efficiency" == "95%"
  back
  clock settle
  tap "prod-panel-2"
  clock settle
  expect tree has "no-inverter"
  back
  clock settle
  tap "production-more"
  tap "edit-config"
  clock settle
  expect tree has "step-1"
  tap "roof-shed"
  clock settle
  type "tilt-slider" "10"
  clock settle
  expect text "tilt" == "Tilt Angle: 10°"
  tap "inverter-10"
  clock settle
  expect text "efficiency" == "62%"
  type "efficiency-slider" "70"
  expect text "efficiency" == "70%"
  tap "inverter-save"
  clock settle
  type "wattage" "400"
  clock settle
  expect text "wattage" == "400"

test "zoom eases over 200 ms through intermediate scales and lands on the target"
  clock +5
  tap "get-started-button"
  clock settle
  tap "continue"
  clock settle
  tap "continue-without-photo"
  clock settle
  expect state scale == 1
  expect state zoom == 0
  tap "zoom-out"
  expect state zoom == 1
  clock +100
  expect state zoomBetween == true
  expect state zoomBusy == true
  expect state scale == 0.8300000000000001
  clock +150
  expect state scale == 0.66
  expect state zoomBusy == false
  expect state zoomBetween == false
  tap "zoom-out"
  expect state zoom == 2
  clock +100
  expect state zoomBetween == true
  expect state zoomBusy == true
  expect state scale == 0.53
  clock +150
  expect state scale == 0.4
  expect state zoomBusy == false
  expect state zoomBetween == false
  tap "zoom-in"
  clock +250
  expect state scale == 0.66
  expect state zoomBusy == false
  expect state zoomBetween == false

