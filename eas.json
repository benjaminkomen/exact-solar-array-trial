{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "ios-exact": {
      "distribution": "store",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.2",
        "config": "ios-exact.yml"
      },
      "autoIncrement": true
    },
    "android-exact": {
      "distribution": "internal",
      "android": {
        "config": "android-exact.yml"
      },
      "autoIncrement": true
    },
    "ios-exact-local": {
      "extends": "ios-exact",
      "autoIncrement": false
    },
    "android-exact-local": {
      "extends": "android-exact",
      "autoIncrement": false
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6833494203"
      }
    }
  }
}
